<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <!-- Local Simulator identity only; never used for device or distribution signing. -->
    <key>application-identifier</key><string>LOCALDEV00.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>com.apple.developer.team-identifier</key><string>LOCALDEV00</string>
    <key>keychain-access-groups</key><array><string>LOCALDEV00.$(PRODUCT_BUNDLE_IDENTIFIER)</string></array>
    <key>get-task-allow</key><true/>
</dict></plist>
