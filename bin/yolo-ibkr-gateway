#!/bin/zsh
set -euo pipefail

script_dir=${0:A:h}
repo_root=${script_dir:h}
python_bin="$repo_root/.venv/bin/python"
if [[ ! -x "$python_bin" ]]; then
  python_bin=/usr/bin/python3
fi

export PYTHONPATH="$repo_root/packages/core-python:$repo_root/agents/yolo-trade/runtime-python${PYTHONPATH:+:$PYTHONPATH}"
exec "$python_bin" -m yolo_trade.gateway_supervisor "$@"
